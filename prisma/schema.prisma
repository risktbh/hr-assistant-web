generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Tabel Induk Baru (Untuk melacak file PDF)
model Document {
  id        String   @id @default(uuid())
  filename  String
  createdAt DateTime @default(now())

  // Relasi ke potongan teks (Chunks)
  chunks DocumentChunk[]
}

// 2. Modifikasi Tabel Chunks Lama
model DocumentChunk {
  id        String                       @id @default(uuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector(3072)")?
  createdAt DateTime                     @default(now())

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// Menyimpan informasi sesi obrolan (judul yang tampil di sidebar)
model ChatSession {
  id        String        @id @default(uuid())
  title     String // Misalnya: "Aturan Cuti Menikah"
  userId    String // ID karyawan (sementara bisa pakai "riski" atau dummy)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[] // Relasi 1 ke banyak (1 sesi punya banyak pesan)
}

// Menyimpan detail pesan dari User dan AI
model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String // "user" atau "assistant"
  content   String // Isi teks pesan
  sources   String[] // Menyimpan sumber referensi dari RAG (array text)
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Menyimpan daftar karyawan untuk fitur Directory
model Employee {
  id         String  @id @default(cuid())
  name       String
  position   String
  department String
  email      String  @unique
  phone      String
  status     String  @default("WFO")
  location   String
  initial    String?

  managerId String?

  manager       Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeManager")

  overtimeRequests        OvertimeRequest[] @relation("EmployeeOvertime")
  managedOvertimeRequests OvertimeRequest[] @relation("ManagerOvertime")

  secondApprovalOvertimeRequests OvertimeRequest[] @relation("SecondApproverOvertime")

  leaveRequests        LeaveRequest[] @relation("EmployeeLeave")
  managedLeaveRequests LeaveRequest[] @relation("ManagerLeave")

  leaveBalances LeaveBalance[]

  reimbursementRequests        ReimbursementRequest[] @relation("EmployeeReimbursement")
  managedReimbursementRequests ReimbursementRequest[] @relation("ManagerReimbursement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([department])
  @@index([status])
  @@index([managerId])
}

enum OvertimeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  SPECIAL
  UNPAID
}

enum WorkflowStatus {
  NOT_STARTED
  TRIGGERED
  RUNNING
  COMPLETED
  FAILED
}

model OvertimeRequest {
  id          String @id @default(cuid())
  requestCode String @unique

  employeeId String
  managerId  String?

  employee Employee @relation("EmployeeOvertime", fields: [employeeId], references: [id], onDelete: Restrict)

  manager Employee? @relation("ManagerOvertime", fields: [managerId], references: [id], onDelete: SetNull)

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  timezone        String @default("Asia/Jakarta")
  durationMinutes Int

  reason        String
  projectName   String?
  taskReference String?

  /**
   * =======================================================
   * OVERALL REQUEST STATUS
   * =======================================================
   */

  status OvertimeStatus @default(PENDING)

  /**
   * =======================================================
   * APPROVAL STATE MACHINE
   * =======================================================
   */

  approvalStage OvertimeApprovalStage @default(MANAGER)

  requiresSecondApproval Boolean @default(false)

  /**
   * MANAGER APPROVAL
   */

  managerDecision ApprovalDecision @default(PENDING)

  managerDecisionNote String?

  managerDecidedAt DateTime? @db.Timestamptz(3)

  /**
   * SECOND APPROVAL
   */

  secondApproverId String?

  secondApprover Employee? @relation("SecondApproverOvertime", fields: [secondApproverId], references: [id], onDelete: SetNull)

  secondDecision ApprovalDecision?

  secondDecisionNote String?

  secondDecidedAt DateTime? @db.Timestamptz(3)

  /**
   * =======================================================
   * POLICY
   * =======================================================
   */

  policyResult Json?

  policySource String?

  /**
   * =======================================================
   * FINAL DECISION
   * =======================================================
   */

  decisionNote String?

  decidedAt DateTime? @db.Timestamptz(3)

  /**
   * =======================================================
   * AUTOMATION
   * =======================================================
   */

  workflowRunId String?

  workflowStatus WorkflowStatus @default(NOT_STARTED)

  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
  @@index([managerId])
  @@index([secondApproverId])
  @@index([status])
  @@index([approvalStage])
  @@index([workflowStatus])
  @@index([startAt])
  @@index([requestedAt])
}

model AuditLog {
  id String @id @default(cuid())

  entityType String
  entityId   String

  action String

  actorType String
  actorId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum OvertimeApprovalStage {
  MANAGER
  SECOND_APPROVER
  COMPLETED
}

model LeaveRequest {
  id          String @id @default(cuid())
  requestCode String @unique

  /**
   * =======================================================
   * EMPLOYEE + APPROVER
   * =======================================================
   */

  employeeId String
  managerId  String?

  employee Employee  @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Restrict)
  manager  Employee? @relation("ManagerLeave", fields: [managerId], references: [id], onDelete: SetNull)

  /**
   * =======================================================
   * LEAVE DETAILS
   * =======================================================
   */

  leaveType LeaveType

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  totalDays Int

  reason String?

  /**
   * =======================================================
   * REQUEST STATUS
   * =======================================================
   */

  status LeaveStatus @default(PENDING)

  /**
   * =======================================================
   * MANAGER APPROVAL
   * =======================================================
   */

  managerDecision ApprovalDecision @default(PENDING)

  managerDecisionNote String?

  managerDecidedAt DateTime? @db.Timestamptz(3)

  /**
   * =======================================================
   * POLICY
   * =======================================================
   */

  policyResult Json?

  policySource String?

  /**
   * =======================================================
   * AUTOMATION / N8N
   * =======================================================
   */

  workflowStatus WorkflowStatus @default(NOT_STARTED)

  workflowRunId String?

  /**
   * =======================================================
   * TIMESTAMPS
   * =======================================================
   */

  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  /**
   * =======================================================
   * INDEXES
   * =======================================================
   */

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@index([leaveType])
  @@index([workflowStatus])
  @@index([startDate])
  @@index([requestedAt])
  @@index([employeeId, status])
  @@index([managerId, status])
}

model LeaveBalance {
  id String @id @default(cuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year Int

  leaveType LeaveType

  entitlementDays Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
  @@index([year])
  @@index([leaveType])
  @@index([employeeId, year])
}

enum ReimbursementType {
  MEDICAL
  TRAVEL
  MEAL
  OTHER
}

enum ReimbursementStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ReimbursementRequest {
  id          String @id @default(cuid())
  requestCode String @unique

  employeeId String
  managerId  String?

  employee Employee  @relation("EmployeeReimbursement", fields: [employeeId], references: [id], onDelete: Restrict)
  manager  Employee? @relation("ManagerReimbursement", fields: [managerId], references: [id], onDelete: SetNull)

  reimbursementType ReimbursementType

  expenseDate DateTime @db.Date

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("IDR")

  merchant String?
  reason   String

  receiptUrl      String?
  receiptFileName String?

  status ReimbursementStatus @default(PENDING)

  managerDecision     ApprovalDecision @default(PENDING)
  managerDecisionNote String?
  managerDecidedAt    DateTime?        @db.Timestamptz(3)

  policyResult Json?
  policySource String?

  workflowStatus WorkflowStatus @default(NOT_STARTED)
  workflowRunId  String?

  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@index([reimbursementType])
  @@index([workflowStatus])
  @@index([expenseDate])
  @@index([requestedAt])
  @@index([employeeId, status])
  @@index([managerId, status])
}
